# Nothing here is required. OpenWeights works out of the box whether you reach it
# at http://localhost:3000, http://192.168.1.x:3000, by hostname, or over a VPN.

# Container timezone, used as the default for new accounts. Each user can change
# theirs in Settings.
TZ=UTC

# Where the SQLite database lives. Must be on a writable volume.
DATABASE_PATH=/data/openweights.db

# HTTP listener.
PORT=3000
HOST=0.0.0.0

# Maximum request body size (set to 0 to disable the limit).
BODY_SIZE_LIMIT=2M

# Set to 1 to refuse new self-registrations even before an admin exists.
# Once the first admin account is created, self-registration closes on its own
# and further accounts are created from Settings -> Users.
DISABLE_SIGNUP=0

# --- Reverse proxy only ---------------------------------------------------

# Only needed if your proxy rewrites the Host header. Comma-separated origins
# allowed to submit forms.
# TRUSTED_ORIGINS=https://gym.example.com,https://gym.tailnet.ts.net

# Public origin, scheme included. Same effect as TRUSTED_ORIGINS, and also marks
# the session cookie Secure when it starts with https://. Only needed if your
# TLS-terminating proxy does not forward X-Forwarded-Proto.
# ORIGIN=https://gym.example.com
