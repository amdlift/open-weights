{
	"name": "OpenWeights",
	"short_name": "OpenWeights",
	"description": "Self-hosted weightlifting, bodyweight and cardio tracker",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#111316",
	"theme_color": "#2d5ed4",
	"icons": [
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Log a workout",
			"short_name": "Log",
			"url": "/workouts/new"
		},
		{
			"name": "Calendar",
			"short_name": "Calendar",
			"url": "/calendar"
		}
	]
}
