{
  "name": "openweights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted weightlifting, bodyweight and cardio tracker",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
